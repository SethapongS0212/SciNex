{"para_id": 8, "raw": "{\n  \"triples\": [\n    {\n      \"subject\": \"Word Embeddings\",\n      \"predicate\": \"addresses\",\n      \"object\": \"visual representations\",\n      \"object_type\": \"Concept\",\n      \"source_sentence\": \"One way to force word embeddings to take visual representations into account is to try to directly increase the similarity (expressed, for example, by the cosine) between linguistic and visual representations, thus aligning the dimensions of the linguistic vector with those of the visual one (recall that we are inducing the first, while the second is fixed), and making the linguistic representation of a concept \\\"move\\\" closer to its visual representation.\"\n    }\n  ]\n}", "n_tokens": 1593, "truncated": false}
