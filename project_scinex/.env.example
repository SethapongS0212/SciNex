# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# Note: citation/apikey.env is a second credential file, also gitignored.

# Semantic Scholar (citation networks) — https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Extraction backends. Only the one you actually run is required.
# Groq     — https://console.groq.com/keys
GROQ_API_KEY=
# Gemini   — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (used for the four-model C1–C6 line-up) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
